# ==============================================================================
# RoundTable Environment Configuration
# Copy this file to .env.local and populate the values for local development.
# ==============================================================================

# Database: MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/roundtable?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/roundtable

# Authentication Secret (Used for signing secure JWT HTTP-only cookies)
# Generate a strong 32+ character random string (e.g., `openssl rand -base64 32`)
AUTH_SECRET=change-me-to-a-super-secret-random-32-byte-hex-or-base64-string

# Session Cookie Configuration (optional override)
# Default is 'roundtable_session'
SESSION_COOKIE_NAME=roundtable_session

# Code Execution Engine: Judge0 API (For Phase 6)
# If using RapidAPI Judge0:
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
# Or self-hosted Judge0:
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# Base URL of application
NEXT_PUBLIC_APP_URL=http://localhost:3000
