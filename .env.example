# ==============================================================================
# RoundCode Environment Configuration
# Copy this file to .env.local and populate the values for local development.
# ==============================================================================

# Database: MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roundcode?retryWrites=true&w=majority

# Authentication Secret (Used for signing secure JWT HTTP-only cookies)
AUTH_SECRET=your_32_byte_secret_key_here

# Session Cookie Configuration (optional override)
SESSION_COOKIE_NAME=roundcode_session

# Base URL of application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Dedicated 4 Admin Credentials (Only these 4 can access Admin Panel)
# ==============================================================================

# Admin 1: Lead Administrator
ADMIN_1_EMAIL=admin.lead@example.com
ADMIN_1_PASSWORD=your_admin_1_password_here
ADMIN_1_NAME=Lead Administrator

# Admin 2: DSA Senior Mentor
ADMIN_2_EMAIL=mentor.dsa@example.com
ADMIN_2_PASSWORD=your_admin_2_password_here
ADMIN_2_NAME=DSA Senior Mentor

# Admin 3: Faculty Code Reviewer
ADMIN_3_EMAIL=review.faculty@example.com
ADMIN_3_PASSWORD=your_admin_3_password_here
ADMIN_3_NAME=Faculty Code Reviewer

# Admin 4: Operations Administrator
ADMIN_4_EMAIL=admin.ops@example.com
ADMIN_4_PASSWORD=your_admin_4_password_here
ADMIN_4_NAME=Operations Admin
